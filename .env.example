# Copy to .env and fill in. Never commit .env.

# Address and port the service listens on (0.0.0.0 inside a container).
HOST=127.0.0.1
PORT=3000

# Postgres. Locally: a container without TLS (DATABASE_SSL=false). In compose.yaml DATABASE_URL is set for you.
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_SSL=false
POSTGRES_PASSWORD=change-me

# Suite identity service (Keycloak realm "suite", ADR 17). Locally: http://localhost:8080/realms/suite.
OIDC_ISSUER=https://id.example.com/realms/suite
# This service's client id in Keycloak; access tokens must name it in "aud" (audience mapper on the client).
OIDC_AUDIENCE=di-example
# Optional: other clients whose person tokens this service accepts (e.g. its web front end), comma-separated.
OIDC_AUTHORIZED_PARTIES=

# Shared secret for signed events between suite services (X-DI-Signature), at least 32 characters.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
DI_EVENTS_SECRET=

# Public domain of the service, for Caddy's TLS certificate (compose.yaml).
SERVICE_DOMAIN=service.example.com
